{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcp-forge.dev/schemas/mcp.package.v1.schema.json",
  "title": "MCP Package Manifest",
  "description": "Schema for MCP server package manifests",
  "type": "object",
  "required": [
    "name",
    "slug",
    "description",
    "homepage",
    "source",
    "license",
    "maintainer",
    "primitives",
    "transports",
    "auth",
    "runtime"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable name of the MCP server"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "maintainer": {
      "type": "object",
      "required": [
        "name",
        "github"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "github": {
          "type": "string"
        },
        "verified": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "primitives": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "prompts": {
          "type": "boolean"
        },
        "resources": {
          "type": "boolean"
        },
        "sampling": {
          "type": "boolean"
        }
      }
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stdio",
          "streamable-http",
          "sse"
        ]
      },
      "minItems": 1
    },
    "auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "api_key",
            "oauth",
            "local-only"
          ]
        },
        "env_var": {
          "type": "string"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "binary",
            "python",
            "node",
            "docker",
            "remote"
          ]
        },
        "image": {
          "type": "string"
        },
        "entrypoint": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "egress": {
              "type": "object",
              "properties": {
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "retries": {
          "type": "number"
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "examples": {
      "type": "array"
    },
    "test_recipe": {
      "type": "object"
    },
    "releases": {
      "type": "array"
    }
  }
}