#!/usr/bin/env python3
"""mcp-validate - validate MCP package manifests against the official schema."""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "packages" / "manifest-spec" / "src"))
from validate import validate_manifest_file


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mcp-validate",
        description="Validate an MCP package manifest against the official schema.",
    )
    parser.add_argument("manifest", nargs="*", default=["mcp.package.json"], help="Path(s) to manifest file(s)")
    parser.add_argument("--schema", default=None, help="Path to an alternate JSON Schema")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable JSON output")
    args = parser.parse_args(argv)

    exit_code = 0
    outputs = []
    for path in args.manifest:
        result = validate_manifest_file(path, args.schema)
        outputs.append({"file": path, **result.to_dict()})
        if args.json:
            continue
        status = "OK" if result.valid else "INVALID"
        print(f"[{status}] {path}")
        for err in result.errors:
            print(f"  error: {err}")
            exit_code = 1
        for warn in result.warnings:
            print(f"  warn:  {warn}")

    if args.json:
        print(json.dumps(outputs, indent=2))
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
