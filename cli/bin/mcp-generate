#!/usr/bin/env python3
"""mcp-generate - generate install configs for supported MCP clients."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "packages" / "client-templates" / "src"))

from generate import generate_install_configs, CLIENTS


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mcp-generate",
        description="Generate ready-to-use install configs for MCP clients.",
    )
    parser.add_argument("manifest", help="Path to an MCP package manifest")
    parser.add_argument("--client", default="all", help=f"Target client: {', '.join(CLIENTS)} (default all)")
    parser.add_argument("--output-dir", "-o", help="Write each config to a file in this directory")
    args = parser.parse_args(argv)

    results = generate_install_configs(args.manifest, args.client)
    if "error" in results:
        print(f"error: {results['error']}", file=sys.stderr)
        sys.exit(2)

    if args.output_dir:
        out_dir = Path(args.output_dir)
        out_dir.mkdir(parents=True, exist_ok=True)
        for client, config in results.items():
            ext = "yaml" if client == "docker-compose" else "json"
            target = out_dir / f"{client}.{ext}"
            target.write_text(config + "\n")
            print(f"Wrote {target}")
    else:
        for client, config in results.items():
            print(f"--- {client} ---")
            print(config)
    sys.exit(0)


if __name__ == "__main__":
    main()
