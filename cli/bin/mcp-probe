#!/usr/bin/env python3
"""mcp-probe - probe an MCP server's runtime and declared capabilities."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "packages" / "runtime" / "src"))

from probe import run_probe


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mcp-probe",
        description="Probe an MCP server manifest: validate, launch, and interrogate.",
    )
    parser.add_argument("manifest", help="Path to an MCP package manifest")
    parser.add_argument("--timeout", type=int, default=10, help="Probe timeout in seconds (default 10)")
    parser.add_argument("--output", "-o", help="Write probe report to file")
    parser.add_argument("--json", action="store_true", help="Force JSON output")
    args = parser.parse_args(argv)

    result = run_probe(args.manifest, timeout=args.timeout)
    if args.output:
        Path(args.output).write_text(json.dumps(result, indent=2))
        print(f"Probe report written to {args.output}")
    print(json.dumps(result, indent=2))
    sys.exit(0 if result.get("overall") else 1)


if __name__ == "__main__":
    main()
