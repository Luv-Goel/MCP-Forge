#!/usr/bin/env python3
"""mcp-score - compute an explainable trust score for an MCP package."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "packages" / "scoring" / "src"))

from score import score_package


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mcp-score",
        description="Compute an explainable trust score for an MCP package manifest.",
    )
    parser.add_argument("manifest", help="Path to an MCP package manifest")
    parser.add_argument("--probe", help="Path to a probe result JSON file (optional)")
    parser.add_argument("--output", "-o", help="Write score to file")
    args = parser.parse_args(argv)

    probe_result = None
    if args.probe:
        try:
            probe_result = json.loads(Path(args.probe).read_text())
        except Exception as exc:
            print(f"error: could not load probe result: {exc}", file=sys.stderr)
            sys.exit(2)

    result = score_package(args.manifest, probe_result)
    if args.output:
        Path(args.output).write_text(json.dumps(result, indent=2))
        print(f"Score written to {args.output}")
    print(json.dumps(result, indent=2))
    sys.exit(0 if result.get("total", 0) >= 0.5 else 1)


if __name__ == "__main__":
    main()
