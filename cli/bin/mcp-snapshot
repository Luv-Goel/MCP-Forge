#!/usr/bin/env python3
"""Create reproducible release snapshots for MCP package manifests."""
import json
import hashlib
import hmac
import os
import sys
import time
from pathlib import Path


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def create_snapshot(manifest_path: str, env=None) -> dict:
    env = env or os.environ
    try:
        m = json.loads(Path(manifest_path).read_text())
    except Exception as e:
        return {"error": str(e)}

    name = m.get("name")
    slug = m.get("slug")
    runtime = m.get("runtime", {})
    releases = m.get("releases", [])
    latest = max(releases, key=lambda r: r.get("published_at", "")) if releases else {}

    snapshot = {
        "snapshot_id": f"{slug}-{int(time.time())}",
        "name": name,
        "slug": slug,
        "version": latest.get("version", "0.0.0"),
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "manifest_hash": sha256_file(manifest_path),
        "manifest_path": str(Path(manifest_path).resolve()),
        "source": m.get("source", {}),
        "runtime": {
            "type": runtime.get("type"),
            "entrypoint": runtime.get("entrypoint", []),
            "image": runtime.get("image"),
            "url": runtime.get("url"),
        },
        "release": {
            "version": latest.get("version"),
            "published_at": latest.get("published_at"),
            "manifest_version": latest.get("manifest_version", "1.0"),
            "signatures": latest.get("signatures", {}),
        },
        "primitives": m.get("primitives", {}),
        "transports": m.get("transports", []),
        "scopes": [s["name"] for s in m.get("scopes", [])],
        "trust_fingerprint": None,
    }
    secret = env.get("TRUST_SECRET")
    if secret:
        raw = json.dumps(snapshot, sort_keys=True).encode()
        snapshot["trust_signature"] = hmac.new(secret.encode(), raw, hashlib.sha256).hexdigest()[:16]
    return snapshot


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Create a reproducible release snapshot.")
    parser.add_argument("manifest", nargs="?", default="mcp.package.json")
    parser.add_argument("--output", "-o", help="Write snapshot JSON to file")
    args = parser.parse_args()

    result = create_snapshot(args.manifest)
    if args.output:
        Path(args.output).write_text(json.dumps(result, indent=2))
        print(f"Snapshot written to {args.output}")
    else:
        print(json.dumps(result, indent=2))
